#include "libft.h"

size_t strlcpy(char *dest,char *src,size_t size)
{
sigset_t i;
i=0;
if (size>0)
{
    while (i<size-1 && size[i]!='\0')
    {
        dest[i]=src[i];
        i++;
    }
    dest[i]='\0';
}
i=0;
while (src !='\0')
{
    i++;
}
return(i);
}